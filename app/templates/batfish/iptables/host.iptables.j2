# Generated by GEMEROTIC for {{ node.id }}
*filter
:INPUT ACCEPT [0:0]
:FORWARD ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
# Permitir tráfico según Conduits de la zona {{ node.zone_name }} ({{ node.zone_id }})
{% for conduit in conduits %}
{% if conduit.target_zone_id == node.zone_id %}
# Conduit: {{ conduit.name }}
{% for proto in conduit.allowed_protocols %}
-A INPUT -p {{ proto | lower }} -j ACCEPT
{% endfor %}
{% endif %}
{% endfor %}
# Bloqueo por defecto (opcional en simulador, pero recomendado para NIS2)
#-A INPUT -j DROP
COMMIT
