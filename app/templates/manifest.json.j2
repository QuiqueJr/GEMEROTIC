{{ {
  "schema": "gemerotic.pipeline.artifacts.v1",
  "topology_name": topology_name,
  "stages": {
    "topology": {
      "payload": "topology/topology.json",
      "canvas": "topology/canvas.json"
    },
    "inventory": {
      "netbox": "inventory/netbox_inventory.json"
    },
    "runtime": {
      "containerlab_nodes": "runtime/containerlab_nodes.json",
      "containerlab_links": "runtime/containerlab_links.json"
    },
    "ansible_vars": {
      "vars": "ansible/vars.json"
    },
    "containerlab": {
      "entrypoint": "containerlab/topology.clab.yml",
      "command": "containerlab deploy --topo containerlab/topology.clab.yml"
    },
    "ansible": {
      "inventory": "ansible/inventory.yml",
      "playbook": "ansible/site.yml",
      "command": "ansible-playbook -i ansible/inventory.yml ansible/site.yml"
    },
    "opa": {
      "input": "opa/input.json",
      "policy": "opa/policies/gemerotic_baseline.rego",
      "command": "opa eval --format pretty --data opa/policies --input opa/input.json data.gemerotic.baseline"
    },
    "batfish": {
      "readme": "batfish/README.md",
      "status": "requires vendor NOS profile before execution"
    }
  }
} | to_pretty_json }}
